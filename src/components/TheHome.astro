---
// The cottage: four interiors from the walkthrough (src/data/gallery.ts),
// living room leading, then the way to every photo. The lead frame shares a
// view-transition name with its tile on /gallery, so it morphs across.
import { Image } from 'astro:assets';
import { homeFeatured, morphName } from '../data/gallery';

const [lead, ...rest] = homeFeatured;
---

<section aria-labelledby="the-home-heading" class="bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <p data-reveal class="text-xs font-semibold uppercase tracking-[0.22em] text-muted">
      The cottage
    </p>
    <h2
      id="the-home-heading"
      data-reveal
      class="mt-3 max-w-[20ch] text-3xl font-semibold tracking-tight text-ink sm:text-5xl"
    >
      Simple, bright, and easy to settle into.
    </h2>
    <p data-reveal class="mt-5 max-w-[54ch] text-lg text-muted">
      Two bedrooms with queen beds, two full bathrooms, a full kitchen, and a
      living room with a wood stove for the cool months. The big windows and
      the deck face the water.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      <figure
        transition:name={morphName(lead)}
        data-parallax
        class="overflow-hidden rounded-2xl sm:col-span-2 sm:row-span-2"
      >
        <Image
          src={lead.src}
          alt={lead.alt}
          widths={[480, 768, 1200, 1800]}
          sizes="(min-width: 640px) 66vw, 100vw"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </figure>
      {
        rest.map((image) => (
          <figure transition:name={morphName(image)} class="overflow-hidden rounded-2xl">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[400, 640, 960]}
              sizes="(min-width: 640px) 33vw, 100vw"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] h-full w-full object-cover"
            />
          </figure>
        ))
      }
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a href="/gallery" class="btn btn-primary">See all photos</a>
      <a href="#inquire" class="link-arrow">
        Request your stay
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>
