---
// Inquire. The whole site exists to produce an inquiry: a short email to
// Brian, not a booking and not a payment. No price and no payment UI here.
//
// Backend: POST /api/inquire, a Vercel Function (api/inquire.ts) that emails
// the host through Resend. The destination address lives only in Vercel's
// environment, never on this page, so it cannot be scraped. The client
// script posts JSON and swaps in the success panel; with JS off the form
// posts normally and the function redirects back here with ?sent=1 or 0.
// A honeypot field and a fill-time stamp keep the obvious bots out.

// Cottage sleeps 4 (CONTEXT.md): guests capped at 4.
const guestOptions = [1, 2, 3, 4];

const fieldClass =
  'w-full rounded-xl border border-line bg-bg px-4 py-3 text-ink placeholder:text-muted/70 transition focus:border-blue focus:outline-none focus:ring-2 focus:ring-blue/40';
const labelClass = 'mb-1.5 block text-sm font-medium text-ink';
---

<section id="inquire" aria-labelledby="inquire-heading" class="bg-surface">
  <div class="mx-auto max-w-3xl px-5 py-20 sm:px-8 sm:py-28">
    <p data-reveal class="text-xs font-semibold uppercase tracking-[0.22em] text-muted">
      Inquire
    </p>
    <h2
      id="inquire-heading"
      data-reveal
      class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl"
    >
      Request your stay
    </h2>
    <p data-reveal class="mt-5 max-w-[54ch] text-lg text-muted">
      Hi Tides sleeps up to four, has a 6-night minimum, and is open
      year-round.
    </p>

    <form
      id="inquiry-form"
      name="inquiry"
      method="POST"
      action="/api/inquire"
      class="mt-8 rounded-2xl bg-bg p-6 ring-1 ring-ink/5 sm:p-9"
    >
      <!-- Bot checks: a field people never see, and when the form appeared. -->
      <p class="hidden" aria-hidden="true">
        <label>Company <input name="company" tabindex="-1" autocomplete="off" /></label>
      </p>
      <input type="hidden" name="started" value="0" data-inquiry-started />

      <div class="grid gap-6 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="inquiry-name" class={labelClass}>Your name</label>
          <input
            type="text"
            id="inquiry-name"
            name="name"
            required
            autocomplete="name"
            class={fieldClass}
          />
        </div>

        <div class="sm:col-span-2">
          <label for="inquiry-email" class={labelClass}>Email</label>
          <input
            type="email"
            id="inquiry-email"
            name="email"
            required
            autocomplete="email"
            class={fieldClass}
          />
        </div>

        <div>
          <label for="inquiry-arrival" class={labelClass}>Arrival</label>
          <input
            type="date"
            id="inquiry-arrival"
            name="arrival"
            class={fieldClass}
          />
        </div>

        <div>
          <label for="inquiry-departure" class={labelClass}>Departure</label>
          <input
            type="date"
            id="inquiry-departure"
            name="departure"
            class={fieldClass}
          />
        </div>

        <div>
          <label for="inquiry-guests" class={labelClass}>Guests</label>
          <select id="inquiry-guests" name="guests" class={fieldClass}>
            {
              guestOptions.map((n) => (
                <option value={n}>
                  {n} {n === 1 ? 'guest' : 'guests'}
                </option>
              ))
            }
          </select>
          <p class="mt-1.5 text-xs text-muted">The cottage sleeps up to 4.</p>
        </div>

        <div class="sm:col-span-2">
          <label for="inquiry-message" class={labelClass}>
            Anything you would like us to know
          </label>
          <textarea
            id="inquiry-message"
            name="message"
            rows="5"
            placeholder="Your dates, who is coming, and anything else that helps"
            class={`${fieldClass} resize-y`}></textarea>
        </div>
      </div>

      <p
        id="inquiry-error"
        hidden
        role="alert"
        class="mt-6 rounded-xl border border-gold/50 bg-gold/10 px-4 py-3 text-sm text-ink"
      >
        Something went wrong sending your inquiry. Please try again in a
        moment.
      </p>

      <button
        type="submit"
        class="btn btn-primary mt-8"
      >
        Send your inquiry
      </button>
    </form>

    <!-- Success panel, revealed by the script on a successful submit. -->
    <div
      id="inquiry-success"
      hidden
      role="status"
      class="mt-8 rounded-2xl bg-bg p-8 text-center ring-1 ring-ink/5 sm:p-12"
    >
      <span
        class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue text-white"
        aria-hidden="true"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </span>
      <h3 class="mt-5 text-2xl font-semibold text-ink">Thanks, your inquiry is on its way</h3>
      <p class="mx-auto mt-3 max-w-[46ch] text-muted">
        Brian will reply by email soon.
      </p>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: post the form as JSON to /api/inquire, then
  // show the success panel. With JS off the browser posts the form itself
  // and the function redirects back with ?sent=1 or ?sent=0.
  //
  // ClientRouter lifecycle: the form DOM is replaced on client-side
  // navigation, so binding lives in an init re-run on astro:page-load.
  function initInquiryForm() {
    const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
    const success = document.getElementById('inquiry-success');
    const errorPanel = document.getElementById('inquiry-error');
    if (!form || !success) return;

    const started = form.querySelector<HTMLInputElement>('[data-inquiry-started]');
    if (started) started.value = String(Date.now());

    // Back from a no-JS submit.
    const sent = new URLSearchParams(location.search).get('sent');
    if (sent === '1') {
      form.hidden = true;
      success.hidden = false;
    } else if (sent === '0' && errorPanel) {
      errorPanel.hidden = false;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorPanel) errorPanel.hidden = true;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;

      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const result = (await response.json().catch(() => ({}))) as { ok?: boolean };
        if (!response.ok || !result.ok) throw new Error(`Request failed: ${response.status}`);

        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        if (errorPanel) errorPanel.hidden = false;
        if (button) button.disabled = false;
      }
    });
  }

  document.addEventListener('astro:page-load', initInquiryForm);
</script>
