---
import { Picture } from 'astro:assets';
import Wordmark from './Wordmark.astro';
import beachStill from '../assets/media/beach-loop.jpg';

// The hero. The processed beach loop (scripts/process-video.sh, from
// Content/videos/drone/"beach video.mov": in from above the water to the
// cottage, cut just before the gimbal pitches down, dissolving back to the
// start) plays full-bleed behind one line and two buttons. No wordmark here
// (the navbar carries it), no eyebrow.
//
// First-paint / no-JS / reduced-motion strategy:
//  - The still (src/assets/media/beach-loop.jpg via <Picture>) is rendered as
//    an always-present image layered behind the video, so the hero looks
//    correct before the video decodes, with JS off, and when motion is
//    reduced. It doubles as the poster, so the video sets none of its own.
//  - Above-the-fold, the hero uses the lean H.264 MP4 only (universal support
//    for muted autoplay loops); the heavier VP9 WebM is skipped here to keep
//    first load light.
//  - The <video> uses preload="metadata" so it never blocks first paint, and
//    is hidden via a scoped reduced-motion media query so only the still
//    shows for visitors who prefer reduced motion.
//
// Autoplay polish (NOTES.md, 2026-11-14): if playback is refused or fails
// (iOS Low Power Mode, "Auto-Play Video Previews" off, Data Saver, a missing
// codec, a failed fetch) the video is removed from layout so the still is the
// hero, no half-loaded frame with a play glyph on it.
//
// Nothing may ever call play() on this element and it takes no pointer
// events. iOS 26 (Safari and every iOS browser, since they are all WebKit)
// will put its full native inline player over a controls-less <video> when a
// tap reaches the video layer or when playback is started by script from a
// user gesture. Seen on Firefox for iOS: pause, skip, scrubber, the lot, on
// top of the hero. The autoplay attribute alone drives playback; if a device
// refuses it, the still is the hero and that is the end of it.
//
// The hero MUST stay full-viewport (min-h-[100svh]) on every breakpoint.
// Chrome's LCP ignores an image/video that covers the whole viewport (it is
// treated as a background), which is why the hero *text* is the LCP element
// (1.5 s). An 88svh phone hero made the video an LCP candidate at 5.3 s under
// Lighthouse's throttling (budget 2.5 s). Measured; not a guess.
---

<section
  data-hero
  class="relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-ink text-white"
>
  <!-- Always-present still: first paint + no-JS + reduced-motion fallback -->
  <!-- Optimized via astro:assets (AVIF/WebP + srcset): the raw JPEG dragged
       mobile LCP. Not fetchpriority=high: the LCP element is the hero *text*,
       so this image must not outrank fonts/CSS. -->
  <Picture
    src={beachStill}
    formats={['avif', 'webp']}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    alt="White-sand beach and clear Atlantic water in Port Mouton, Nova Scotia"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover"
  />

  <!-- Processed beach loop layered on top; removed if it cannot play; hidden
       under reduced motion -->
  <video
    class="hero-video pointer-events-none absolute inset-0 h-full w-full object-cover"
    data-hero-video
    autoplay
    muted
    loop
    playsinline
    disablepictureinpicture
    disableremoteplayback
    controlslist="nodownload nofullscreen noremoteplayback"
    x-webkit-airplay="deny"
    preload="metadata"
    aria-label="Aerial video flying in over the beach to the cottage in Port Mouton, Nova Scotia"
  >
    <source src="/media/beach-loop.mp4" type="video/mp4" />
  </video>

  <!-- Coastal gradient for legible white text -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-ink/55 via-ink/25 to-ink/55"
    aria-hidden="true"
  >
  </div>

  <!-- Foreground: centred, nothing but the line and the two ways in -->
  <div class="relative z-10 mx-auto w-full max-w-4xl px-6 pb-24 pt-28 text-center">
    <h1 class="text-balance text-5xl font-semibold tracking-tight sm:text-7xl">
      A cottage above the beach.
    </h1>
    <p class="mx-auto mt-6 max-w-[40ch] text-balance text-lg text-white/85 sm:text-xl">
      Two bedrooms on Nova Scotia's South Shore, with the bay in front of you
      and white sand five minutes down the road.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="#inquire" class="btn btn-primary">Request your stay</a>
      <a href="/gallery" class="btn btn-light">See the photos</a>
    </div>
  </div>
</section>

<style>
  /* Set by the script when playback is refused or fails: the still beneath is
     the hero. Cleared again the moment the loop actually plays. */
  .hero-video.is-blocked {
    display: none;
  }

  /* Belt and braces for WebKit: never show the inline start-playback glyph or
     any other native chrome on this decorative, muted loop. */
  .hero-video::-webkit-media-controls,
  .hero-video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  /* Reduced-motion / no-video fallback: hide the looping video so only the
     still image background shows. The still <img> beneath always remains. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }
</style>

<script>
  // Hero loop lifecycle. The video is visible from the first paint (it has no
  // poster, so the still shows through until the first frame decodes) and is
  // left to the autoplay attribute. If it cannot play it is hidden, leaving
  // the still, which is also exactly what reduced-motion visitors get (for
  // them autoplay is cancelled up front, so only the preload metadata is
  // ever fetched).
  //
  // ClientRouter: the hero DOM is replaced on every client-side navigation
  // back to the story page, so binding re-runs on astro:page-load.
  const REDUCED = '(prefers-reduced-motion: reduce)';
  // Autoplay refusal raises no event. If the first frame is in hand and
  // nothing has started this long after it, treat autoplay as refused (or
  // the network as too slow to matter) and show the still instead.
  const GRACE_MS = 800;

  function initHeroVideo(): void {
    const video = document.querySelector<HTMLVideoElement>('video[data-hero-video]');
    if (!video) return;

    if (window.matchMedia(REDUCED).matches) {
      video.removeAttribute('autoplay');
      video.pause();
      return;
    }

    const block = () => video.classList.add('is-blocked');
    const unblock = () => video.classList.remove('is-blocked');

    video.addEventListener('playing', unblock);
    video.addEventListener('error', block);
    // A failed fetch of the only <source> reports on the source element, and
    // may already have happened before this script ran.
    for (const source of video.querySelectorAll('source')) {
      source.addEventListener('error', block);
    }
    if (video.error || video.networkState === video.NETWORK_NO_SOURCE) block();

    const check = () => {
      if (video.isConnected && video.paused) block();
    };
    const arm = (delay: number) => () => window.setTimeout(check, delay);
    if (video.readyState >= video.HAVE_CURRENT_DATA) arm(GRACE_MS)();
    else video.addEventListener('loadeddata', arm(GRACE_MS), { once: true });
    // If only metadata ever arrives (autoplay refused with preload=metadata)
    // there is no first frame to wait for; give it longer, then decide.
    if (video.readyState >= video.HAVE_METADATA) arm(GRACE_MS * 3)();
    else video.addEventListener('loadedmetadata', arm(GRACE_MS * 3), { once: true });

    // Deliberately no gesture retry: script-started playback is one of the two
    // things that make iOS 26 draw its native player over the hero.
  }

  document.addEventListener('astro:page-load', initHeroVideo);
</script>
