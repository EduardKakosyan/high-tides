---
// The area: what is nearby and how far, no photos. The map stays zoomed to
// town level with no marker: the exact address is shared only after an
// inquiry.

interface Place {
  name: string;
  distance: string;
  note: string;
  /** Inline SVG path data (24x24 viewBox, stroke-based). */
  icon: string;
}

const places: Place[] = [
  {
    name: 'Carters Beach',
    distance: '5-minute drive',
    note: 'White sand and clear water.',
    icon: 'M2 18h20 M4 18c2-4 5-6 8-6s6 2 8 6 M12 12V6 M9 6h6 M12 3l3 3-3 0z',
  },
  {
    name: 'Seascape Convenience',
    distance: '6 km, on the way to Carters',
    note: 'A corner store for the essentials.',
    icon: 'M3 9l1.5-5h15L21 9 M3 9h18 M3 9v11h18V9 M9 20v-6h6v6',
  },
  {
    name: 'Liverpool',
    distance: '20-minute drive',
    note: 'Groceries, restaurants, pharmacy, hardware, the lot.',
    icon: 'M3 21V9l9-6 9 6v12 M9 21v-6h6v6 M3 21h18',
  },
  {
    name: 'Halifax',
    distance: 'About 90 minutes',
    note: 'A 90-minute drive from the city, straight down Highway 103.',
    icon: 'M3 21h18 M5 21V7l6-4v18 M11 21V11l8-4v14 M8 9h0 M8 13h0 M8 17h0 M15 12h0 M15 16h0',
  },
  {
    name: 'Halifax Stanfield Airport',
    distance: 'About a 2-hour drive',
    note: 'Fly in, drive down the shore.',
    icon: 'M2 16l20-6 M10 20l4-10 M14 4l-2 6 M4 12l6 1',
  },
];

// Approximate-only OpenStreetMap embed, centred on the village at town zoom.
const bbox = { west: -64.87, south: 43.915, east: -64.79, north: 43.965 };
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox.west}%2C${bbox.south}%2C${bbox.east}%2C${bbox.north}&layer=mapnik`;
const mapLink = 'https://www.openstreetmap.org/#map=13/43.94/-64.83';
---

<section aria-labelledby="the-area-heading" class="bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <p data-reveal class="text-xs font-semibold uppercase tracking-[0.22em] text-muted">
      The area
    </p>
    <h2
      id="the-area-heading"
      data-reveal
      class="mt-3 max-w-[20ch] text-3xl font-semibold tracking-tight text-ink sm:text-5xl"
    >
      Port Mouton, on Nova Scotia's South Shore.
    </h2>
    <p data-reveal class="mt-5 max-w-[54ch] text-lg text-muted">
      A small fishing village with some of the best beaches in the province.
      Everything you need is a short drive away.
    </p>

    <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-14">
      <ul data-stagger class="divide-y divide-line">
        {
          places.map((place) => (
            <li class="flex items-start gap-4 py-5 first:pt-0">
              <svg
                class="mt-1 h-6 w-6 shrink-0 text-blue"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={place.icon} />
              </svg>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                  <span class="font-head text-lg font-semibold text-ink">{place.name}</span>
                  <span class="text-sm font-medium text-blue">{place.distance}</span>
                </div>
                <p class="mt-0.5 text-sm text-muted">{place.note}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <figure class="overflow-hidden rounded-2xl bg-bg ring-1 ring-ink/5">
        <iframe
          title="Approximate location of Hi Tides in the Port Mouton area on Nova Scotia's South Shore"
          src={mapSrc}
          class="aspect-[4/3] w-full border-0"
          loading="lazy"></iframe>
        <figcaption class="px-4 py-3 text-sm text-muted">
          The general Port Mouton area. The exact address comes with your
          booking details.{' '}
          <a
            href={mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-blue underline-offset-2 hover:underline"
          >
            Open the map
          </a>
        </figcaption>
      </figure>
    </div>

    <div class="mt-10">
      <a href="#inquire" class="link-arrow">
        Request your stay
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>
