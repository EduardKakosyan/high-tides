---
// The navbar. Fixed to the top on every page; two looks, switched by
// src/scripts/tabs.ts through the data-over-hero attribute:
//
//   over the hero  transparent, white wordmark and text, glass CTA
//   elsewhere      cool-white glass with a hairline, colour wordmark
//
// Desktop (md+): wordmark, the section links (scroll the story page, current
// one highlighted), and the Inquire button. Phones: a top row with the
// wordmark and Inquire button, and a row of tabs underneath that switch the
// section panels. Once a phone scrolls past the hero the top row folds away
// and only the slim tab row stays, so the bar costs 44px, not 100.
//
// Both wordmark finishes are rendered and CSS shows the right one, so the
// swap costs no script and no image reload.
import Wordmark from './Wordmark.astro';
import { storyTabs } from '../data/tabs';

// On the story page the links are in-page anchors; anywhere else (/gallery)
// they lead back to that section of the story page. The phone tab row only
// exists where there are panels to switch.
const onStory = Astro.url.pathname === '/';
const base = onStory ? '' : '/';
const navTabs = storyTabs.filter((t) => t.id !== 'inquiry');
---

<header data-site-header class="site-header fixed inset-x-0 top-0 z-40">
  <div
    class="nav-top mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8 md:h-16"
  >
    <a href="/" class="inline-flex shrink-0" aria-label="Hi Tides, home">
      <Wordmark class="wordmark-brand h-9 md:h-10" />
      <Wordmark variant="light" class="wordmark-light h-9 md:h-10" />
    </a>

    <nav aria-label="Sections" class="hidden md:block" data-navlinks>
      <ul class="flex items-center gap-1">
        {
          navTabs.map((tab) => (
            <li>
              <a href={`${base}#${tab.id}`} data-tab={tab.id} class="nav-link">
                {tab.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href={`${base}#inquire`} class="nav-cta">Inquire</a>
  </div>

  {
    onStory && (
      <div class="nav-tabs md:hidden" data-tablist-wrap>
        <div
          role="tablist"
          aria-label="Sections"
          data-tablist
          class="mx-auto flex max-w-6xl gap-1 overflow-x-auto px-3 pb-2 pt-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {storyTabs.map((tab) => (
            <a href={`#${tab.id}`} data-tab={tab.id} class="tab-pill">
              {tab.label}
            </a>
          ))}
        </div>
      </div>
    )
  }
</header>

<script>
  import '../scripts/tabs';
</script>
