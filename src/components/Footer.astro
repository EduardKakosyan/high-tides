---
import Wordmark from './Wordmark.astro';
---

<footer class="border-t border-line bg-bg py-14 text-center">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <a href="/" class="inline-flex justify-center" aria-label="Hi Tides — home">
      <Wordmark class="mx-auto h-16" />
    </a>
    <p class="mt-3 text-sm text-muted">
      Port Mouton, Nova Scotia · A quiet perch above the Atlantic
    </p>
    <p class="mt-1 text-xs text-muted/80">
      &copy; {new Date().getFullYear()} Hi Tides. All rights reserved.
    </p>
  </div>
</footer>
