---
import Wordmark from './Wordmark.astro';
---

<footer class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <a href="/" class="inline-flex" aria-label="Hi Tides, home">
          <Wordmark variant="light" class="h-14" />
        </a>
        <p class="mt-4 text-sm text-white/70">
          A cottage above the beach. Port Mouton, Nova Scotia.
        </p>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
        <li><a href="/gallery" class="text-white/80 hover:text-white">Photos</a></li>
        <li><a href="#inquire" class="text-white/80 hover:text-white">Request your stay</a></li>
        <li><a href="mailto:briangreening@eastlink.ca" class="text-white/80 hover:text-white">Email Brian</a></li>
      </ul>
    </div>
    <p class="mt-10 text-xs text-white/50">
      &copy; {new Date().getFullYear()} Hi Tides. All rights reserved.
    </p>
  </div>
</footer>
