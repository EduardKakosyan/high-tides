---
// Section 2 — "The View" (issue #10).
// The differentiator: the cottage sits *above* the beach with a commanding
// Atlantic view — not beachfront, better. Drone-led so the first thing a
// Guest reads is the cottage-above-the-shore relationship. Dark band so it
// reads as a confident, cinematic beat distinct from the lighter sections.
import { Image } from 'astro:assets';
// Establishing shot: the cottage in the foreground with the white-sand beach
// and the open bay beyond — the whole point of "the view."
import aerialBay from '../assets/media/dji_20250819115309_0032_d.jpg';
// The cottage framed against the coastline and bay behind it.
import aerialVista from '../assets/media/dji_20250819115401_0037_d.jpg';
---

<section aria-labelledby="the-view-heading" class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:px-8">
    <p
      class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-gold"
    >
      The view
    </p>
    <h2
      id="the-view-heading"
      class="max-w-[20ch] font-head text-3xl font-semibold sm:text-4xl lg:text-5xl"
    >
      High enough to see the whole bay.
    </h2>
    <p class="mt-5 max-w-[52ch] text-lg text-white/85">
      The cottage is set above the shore, not down at sea level. From here, the
      beach, bay, and open Atlantic all sit in front of you.
    </p>
    <p class="mt-4 max-w-[52ch] text-lg text-white/85">
      Walk down to the sand when you want the beach. Come back up when you want
      the view. Morning, evening, clear weather, rough weather, it is the kind
      of outlook that changes all day without ever getting old.
    </p>

    <!-- Lead drone frame: the cottage-above-the-shore relationship -->
    <figure class="mt-12 overflow-hidden rounded-2xl border border-white/10">
      <Image
        src={aerialBay}
        alt="Aerial view of Hi Tides above the white-sand beach and bay in Port Mouton, Nova Scotia"
        widths={[480, 768, 1200, 1800]}
        sizes="(min-width: 1024px) 1152px, 100vw"
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover"
      />
    </figure>

    <!-- Supporting vista + the vantage in words -->
    <div class="mt-6 grid items-center gap-6 sm:grid-cols-5">
      <figure
        class="overflow-hidden rounded-2xl border border-white/10 sm:col-span-3"
      >
        <Image
          src={aerialVista}
          alt="Hi Tides cottage overlooking the South Shore coastline and Atlantic bay"
          widths={[480, 768, 1200, 1800]}
          sizes="(min-width: 640px) 60vw, 100vw"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </figure>
      <p class="max-w-[34ch] text-base text-white/80 sm:col-span-2">
        A short walk to the sand, with the full bay waiting when you come back.
      </p>
    </div>
  </div>
</section>
