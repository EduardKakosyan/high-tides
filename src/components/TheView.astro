---
// The view: the one thing that sets the cottage apart. Three photos: the
// drone frame that shows the cottage sitting above the beach, the beach on a
// clear day, and the bay through the front window.
import { Image } from 'astro:assets';
import aerialBay from '../assets/media/dji_20250819115309_0032_d.jpg';
import viewFromWindow from '../assets/media/view-2.jpg';
import { beachWaves } from '../data/gallery';
---

<section aria-labelledby="the-view-heading" class="bg-ink text-white">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <p data-reveal class="text-xs font-semibold uppercase tracking-[0.22em] text-gold">
      The view
    </p>
    <h2
      id="the-view-heading"
      data-reveal
      class="mt-3 max-w-[20ch] font-head text-3xl font-semibold tracking-tight sm:text-5xl"
    >
      High enough to see the whole bay.
    </h2>
    <p data-reveal class="mt-5 max-w-[54ch] text-lg text-white/80">
      Hi Tides sits on the rise above the shore. From the deck and the front
      windows you look straight out over the bay to the islands. Carters Beach,
      white sand and clear water, is a five-minute drive.
    </p>

    <figure data-parallax class="mt-12 overflow-hidden rounded-2xl">
      <Image
        src={aerialBay}
        alt="Aerial view of Hi Tides above the white-sand beach and bay in Port Mouton, Nova Scotia"
        widths={[480, 768, 1200, 1800]}
        sizes="(min-width: 1024px) 1152px, 100vw"
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover"
      />
    </figure>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <figure class="overflow-hidden rounded-2xl">
        <Image
          src={beachWaves.src}
          alt={beachWaves.alt}
          widths={[480, 768, 1200]}
          sizes="(min-width: 640px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </figure>
      <figure class="overflow-hidden rounded-2xl">
        <Image
          src={viewFromWindow}
          alt="The bay through the cottage's front window"
          widths={[480, 768, 1200]}
          sizes="(min-width: 640px) 50vw, 100vw"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </figure>
    </div>

    <div class="mt-10">
      <a href="#inquire" class="link-arrow link-arrow-light">
        Request your stay
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>
