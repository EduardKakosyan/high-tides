---
// Section 3 — Quick-facts row (issue #9).
// A compact, scannable strip of the cottage's hard facts: the kind of
// reassurance a booking engine would normally surface. Self-contained,
// dependency-free (inline SVG icons), responsive grid that collapses on
// mobile. "Cool & coastal" tokens throughout.

interface Fact {
  label: string;
  detail?: string;
  /** Inline SVG path data (24×24 viewBox, stroke-based). */
  icon: string;
}

// Primary facts get the larger, prominent treatment; the rest read as a
// quieter supporting row.
const primary: Fact[] = [
  {
    label: 'Sleeps 4',
    detail: 'Two queen beds',
    icon: 'M2 4v16 M2 10h18a2 2 0 0 1 2 2v8 M22 14H2 M6 10V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v3',
  },
  {
    label: '2 bedrooms',
    detail: 'Simple, comfortable rooms',
    icon: 'M3 21V8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v13 M3 14h18 M7 10h4 M13 10h4',
  },
  {
    label: '2 full baths',
    detail: 'Space for couples or a small family',
    icon: 'M4 12V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2 M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z M6 19l-1 2 M19 19l1 2',
  },
  {
    label: 'Wood stove',
    detail: 'Warm in the cooler months',
    icon: 'M12 3s4 3 4 7a4 4 0 0 1-8 0c0-1.5.7-2.6 1.3-3.4C10 8.5 12 7 12 3z M9 21h6 M10 21v-2a2 2 0 0 1 4 0v2',
  },
  {
    label: 'Full kitchen',
    detail: 'Cook in when you want to stay close',
    icon: 'M3 2v7a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V2 M5 2v9 M5 11v11 M17 2c-1.7 0-3 2.2-3 5 0 2.3 1 3.8 2 4v11h2V2z',
  },
  {
    label: 'Year-round',
    detail: 'Open in every season',
    icon: 'M12 2v20 M2 12h20 M5 5l14 14 M19 5 5 19',
  },
];

// Supporting amenities — a tidy comma row of the rest.
const more: string[] = ['Washer / dryer', 'AC + heat', 'Parking'];
---

<section
  aria-labelledby="quick-facts-heading"
  class="border-y border-line bg-surface"
>
  <div class="mx-auto max-w-6xl px-6 py-16 sm:px-8 sm:py-20">
    <p
      class="mb-3 text-center text-xs font-semibold uppercase tracking-[0.22em] text-muted"
    >
      The essentials
    </p>
    <h2
      id="quick-facts-heading"
      class="text-center text-2xl font-semibold sm:text-3xl"
    >
      Everything you need for a quiet stay.
    </h2>

    <ul
      class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6"
    >
      {
        primary.map((fact) => (
          <li
            class="flex flex-col items-center gap-2 rounded-2xl border border-line bg-bg px-4 py-6 text-center"
          >
            <svg
              class="h-7 w-7 text-blue"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={fact.icon} />
            </svg>
            <span class="font-head text-base font-semibold leading-tight text-ink">
              {fact.label}
            </span>
            {fact.detail && (
              <span class="text-xs text-muted">{fact.detail}</span>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-center text-sm text-muted">
      {
        more.map((item, i) => (
          <span>
            <span class="font-medium text-ink">{item}</span>
            {i < more.length - 1 && <span aria-hidden="true"> · </span>}
          </span>
        ))
      }
    </p>
  </div>
</section>
