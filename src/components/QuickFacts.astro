---
// The essentials: the hard facts a booking engine would normally surface, as
// one scannable strip. Inline SVG icons, no dependencies. On phones this
// leads the Overview tab (index.astro) so the facts are the first thing a
// visitor reaches after the hero.

interface Fact {
  label: string;
  detail: string;
  /** Inline SVG path data (24x24 viewBox, stroke-based). */
  icon: string;
}

const facts: Fact[] = [
  {
    label: 'Sleeps 4',
    detail: 'Up to four guests',
    icon: 'M2 4v16 M2 10h18a2 2 0 0 1 2 2v8 M22 14H2 M6 10V7a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v3',
  },
  {
    label: '2 bedrooms',
    detail: 'A queen bed in each',
    icon: 'M3 21V8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v13 M3 14h18 M7 10h4 M13 10h4',
  },
  {
    label: '2 full baths',
    detail: 'One en suite',
    icon: 'M4 12V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2 M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z M6 19l-1 2 M19 19l1 2',
  },
  {
    label: 'Full kitchen',
    detail: 'Cook when you feel like it',
    icon: 'M3 2v7a2 2 0 0 0 2 2h0a2 2 0 0 0 2-2V2 M5 2v9 M5 11v11 M17 2c-1.7 0-3 2.2-3 5 0 2.3 1 3.8 2 4v11h2V2z',
  },
  {
    label: 'Wood stove',
    detail: 'For the cool months',
    icon: 'M12 3s4 3 4 7a4 4 0 0 1-8 0c0-1.5.7-2.6 1.3-3.4C10 8.5 12 7 12 3z M9 21h6 M10 21v-2a2 2 0 0 1 4 0v2',
  },
  {
    label: 'Year-round',
    detail: 'Open in every season',
    icon: 'M12 2v20 M2 12h20 M5 5l14 14 M19 5 5 19',
  },
];

const more = ['Washer and dryer', 'Heat and AC', 'Parking', 'Outdoor shower', 'No pets'];
---

<section aria-labelledby="quick-facts-heading" class="border-y border-line bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <h2
      id="quick-facts-heading"
      data-reveal
      class="text-xs font-semibold uppercase tracking-[0.22em] text-muted"
    >
      The essentials
    </h2>

    <ul data-stagger class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        facts.map((fact) => (
          <li class="flex flex-col gap-2 rounded-2xl bg-bg px-4 py-5 ring-1 ring-ink/5">
            <svg
              class="h-6 w-6 text-blue"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={fact.icon} />
            </svg>
            <span class="font-head text-base font-semibold leading-tight text-ink">{fact.label}</span>
            <span class="text-xs text-muted">{fact.detail}</span>
          </li>
        ))
      }
    </ul>

    <p class="mt-5 text-sm text-muted">
      {
        more.map((item, i) => (
          <span>
            <span class="font-medium text-ink">{item}</span>
            {i < more.length - 1 && <span aria-hidden="true"> · </span>}
          </span>
        ))
      }
    </p>
  </div>
</section>
