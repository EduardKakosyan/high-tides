---
// The host. Brian Greening, by name, in his own words. A small round
// placeholder stands in for the portrait until the real photo lands: drop it
// at src/assets/media/host-brian.jpg and swap the circle for
// <Image src={brian} alt="Brian Greening, host of Hi Tides" class="h-24 w-24 rounded-full object-cover" />.

const hostName = 'Brian Greening';
const initials = 'BG';
---

<section aria-labelledby="the-host-heading" class="bg-bg">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="flex items-start gap-5 sm:gap-8">
      <div
        class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-surface to-cedar/35 ring-1 ring-ink/5 sm:h-24 sm:w-24"
        role="img"
        aria-label="Portrait of Brian Greening, host of Hi Tides, coming soon"
      >
        <span class="font-head text-xl font-semibold tracking-tight text-cedar sm:text-3xl" aria-hidden="true">
          {initials}
        </span>
      </div>

      <div class="min-w-0">
        <p data-reveal class="text-xs font-semibold uppercase tracking-[0.22em] text-muted">
          Your host
        </p>
        <h2
          id="the-host-heading"
          data-reveal
          class="mt-2 text-3xl font-semibold tracking-tight sm:text-5xl"
        >
          {hostName}
        </h2>
        <p data-reveal class="mt-5 max-w-[56ch] text-lg text-muted">
          I built Hi Tides to share our piece of heaven with others. Reach out
          through the form and I will get back to you!
        </p>
        <a href="#inquire" class="btn btn-primary mt-8">Send an inquiry</a>
      </div>
    </div>
  </div>
</section>
