---
// The host. Brian Greening, by name, in his own voice, with the promise that
// he answers personally. Portrait placeholder until the real photo lands:
// drop it at src/assets/media/host-brian.jpg and swap the block below for
// <Image src={brian} alt="Brian Greening, host of Hi Tides" ... />.

const hostName = 'Brian Greening';
const initials = 'BG';
---

<section aria-labelledby="the-host-heading" class="bg-bg">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,18rem)_1fr] lg:gap-16">
      <div class="mx-auto w-full max-w-xs lg:mx-0">
        <div
          class="flex aspect-square w-full items-center justify-center rounded-3xl bg-gradient-to-br from-surface to-cedar/30 ring-1 ring-ink/5"
          role="img"
          aria-label="Portrait of Brian Greening, host of Hi Tides, coming soon"
        >
          <span class="font-head text-6xl font-semibold tracking-tight text-cedar sm:text-7xl" aria-hidden="true">
            {initials}
          </span>
        </div>
      </div>

      <div>
        <p data-reveal class="text-xs font-semibold uppercase tracking-[0.22em] text-muted">
          Your host
        </p>
        <h2
          id="the-host-heading"
          data-reveal
          class="mt-3 text-3xl font-semibold tracking-tight sm:text-5xl"
        >
          {hostName}
        </h2>
        <p data-reveal class="mt-6 max-w-[56ch] text-lg text-muted">
          I built Hi Tides to share our piece of heaven with others. Reach out
          through the form and I will get back to you!
        </p>
        <a href="#inquire" class="btn btn-primary mt-8">Send an inquiry</a>
      </div>
    </div>
  </div>
</section>
