---
// The host. Brian Greening, by name, in his own words, with his photo (on
// his boat in the bay, the cottages behind him). The portrait is deliberately
// not in the gallery; it lives only here.
import { Image } from 'astro:assets';
import brian from '../assets/media/host-brian.jpg';

const hostName = 'Brian Greening';
---

<section aria-labelledby="the-host-heading" class="bg-bg">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="flex items-start gap-5 sm:gap-8">
      <Image
        src={brian}
        alt="Brian Greening, host of Hi Tides, on his boat in Port Mouton bay"
        width={320}
        height={320}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
        class="h-24 w-24 shrink-0 rounded-full object-cover object-[50%_30%] ring-1 ring-ink/10 sm:h-40 sm:w-40"
      />

      <div class="min-w-0">
        <p data-reveal class="text-xs font-semibold uppercase tracking-[0.22em] text-muted">
          Your host
        </p>
        <h2
          id="the-host-heading"
          data-reveal
          class="mt-2 text-3xl font-semibold tracking-tight sm:text-5xl"
        >
          {hostName}
        </h2>
        <p data-reveal class="mt-5 max-w-[56ch] text-lg text-muted">
          I built Hi Tides to share our piece of heaven with others. Reach out
          through the form and I will get back to you!
        </p>
        <a href="#inquire" class="btn btn-primary mt-8">Send an inquiry</a>
      </div>
    </div>
  </div>
</section>
