---
import Base from '../layouts/Base.astro';

// The Hi Tides story page, assembled in the locked section order (NOTES.md):
// Hero → The View → Quick facts → The Experience → The Home → The Area →
// The Host → Good to know / How it works → Inquire.
// Each section is a self-contained component so this page stays a thin spine.
import Hero from '../components/Hero.astro'; // #7
import TheView from '../components/TheView.astro'; // #10
import QuickFacts from '../components/QuickFacts.astro'; // #9
import TheExperience from '../components/TheExperience.astro'; // #10
import OutdoorShower from '../components/OutdoorShower.astro';
import TheHome from '../components/TheHome.astro'; // #11
import TheArea from '../components/TheArea.astro'; // #12
import TheHost from '../components/TheHost.astro'; // #13
import GoodToKnow from '../components/GoodToKnow.astro'; // #9
import InquiryForm from '../components/InquiryForm.astro'; // #8
---

<Base>
  <Hero />
  <TheView />
  <QuickFacts />
  <TheExperience />
  <OutdoorShower />
  <TheHome />
  <TheArea />
  <TheHost />
  <GoodToKnow />
  <InquiryForm />
</Base>
