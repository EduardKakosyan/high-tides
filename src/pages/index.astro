---
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
// Issue #9 — trust-building blocks (quick facts + how it works)
import QuickFacts from '../components/QuickFacts.astro';
import GoodToKnow from '../components/GoodToKnow.astro';

// Walking-skeleton home page: a single, sparse-but-real section in the
// "Cool & coastal" system. The placeholder hero block stands in until the
// real beach->house drone hero lands in issue #3.
---

<Base>
  <!-- Placeholder hero — real cinematic hero comes in #3 -->
  <section
    class="relative flex min-h-[88svh] items-end overflow-hidden bg-ink text-white"
  >
    <!-- Coastal gradient placeholder backdrop (stands in for the drone clip) -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-ink via-blue/60 to-cedar/70"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-ink/30"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 mx-auto w-full max-w-6xl px-6 pb-20 sm:px-8">
      <p
        class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-white/80"
      >
        Port Mouton · Nova Scotia
      </p>
      <h1 class="max-w-[16ch] text-4xl font-semibold sm:text-6xl lg:text-7xl">
        A cottage above the beach.
      </h1>
      <p class="mt-5 max-w-[42ch] text-lg text-white/90 sm:text-xl">
        Perched over the white sand of Port Mouton, on Nova Scotia&rsquo;s South
        Shore — where the whole bay opens up below you.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#inquire"
          class="rounded-full bg-gold px-7 py-3.5 font-semibold text-ink transition-transform hover:-translate-y-0.5"
        >
          Request your stay
        </a>
        <a
          href="#inquire"
          class="rounded-full border border-white/70 px-7 py-3.5 font-semibold text-white transition-colors hover:bg-white/10"
        >
          Take a look
        </a>
      </div>
    </div>
  </section>

  <!-- Issue #9 — quick-facts row (section 3), straight after the hero -->
  <QuickFacts />

  <!-- Issue #9 — "Good to know / how it works" (section 8), before inquire CTA -->
  <GoodToKnow />

  <!-- Sparse-but-real intro band so the page reads as a real site, not a stub -->
  <section id="inquire" class="bg-surface">
    <div class="mx-auto max-w-3xl px-6 py-24 text-center sm:px-8">
      <p
        class="mb-4 text-xs font-semibold uppercase tracking-[0.22em] text-muted"
      >
        Welcome to
      </p>
      <Wordmark class="text-4xl sm:text-5xl" />
      <p class="mx-auto mt-6 max-w-[52ch] text-lg text-muted">
        A quiet two-bedroom cottage that sleeps four, open year-round. No booking
        engines, no fuss — send a note with your dates and Brian will get back to
        you personally. The full story, the view, and the inquiry form are on
        their way.
      </p>
    </div>
  </section>
</Base>
