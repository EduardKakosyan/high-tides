---
// /gallery — the full photo set, grouped by room/area (issue #11).
//
// Each thumbnail is an accessible <button> that opens the shared, dependency-
// free Lightbox (keyboard nav, focus trap, focus restore, Escape/backdrop
// close). Thumbnails flow through Astro's <Image> (AVIF/WebP + srcset, lazy);
// the lightbox full-view URL is pre-generated with getImage so the overlay
// loads an optimized WebP rather than the raw source.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import { groups, allImages, morphName } from '../data/gallery';

// Pre-generate an optimized full-size WebP for each image, in the same order as
// allImages, so the lightbox triggers can carry a clean URL + a stable index.
const fullViews = await Promise.all(
  allImages.map((image) =>
    getImage({ src: image.src, width: 1600, format: 'webp' }),
  ),
);

// Map each image (by reference) to its global index + full-view URL.
const indexOf = new Map(allImages.map((image, i) => [image, i]));
---

<Base
  title="Photo Gallery, Hi Tides, Port Mouton, Nova Scotia"
  description="A full look inside Hi Tides, a two-bedroom cottage above the beach in Port Mouton, Nova Scotia, including the living spaces, kitchen, bedrooms, bathrooms, deck, exterior, and ocean views."
>
  <section class="bg-bg">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:px-8 sm:py-24">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-semibold text-blue transition-colors hover:text-ink"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Back to home
      </a>

      <p
        class="mt-8 text-xs font-semibold uppercase tracking-[0.22em] text-muted"
      >
        The gallery
      </p>
      <h1 class="mt-3 max-w-[20ch] text-4xl font-semibold text-ink sm:text-5xl">
        Take a look around.
      </h1>
      <p class="mt-4 max-w-[56ch] text-base text-muted">
        A full look at Hi Tides, including the living spaces, kitchen, bedrooms,
        bathrooms, deck, exterior, and the details that make the cottage feel
        comfortable and lived in. Select any photo to view it larger.
      </p>

      {
        groups.map((group) => (
          <section aria-labelledby={`group-${group.id}`} class="mt-16">
            <h2
              id={`group-${group.id}`}
              class="font-head text-2xl font-semibold text-ink"
            >
              {group.title}
            </h2>
            <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
              {group.images.map((image) => {
                const i = indexOf.get(image)!;
                const full = fullViews[i];
                return (
                  <li transition:name={morphName(image)}>
                    <button
                      type="button"
                      class="group block w-full overflow-hidden rounded-2xl border border-line focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                      data-lightbox-trigger
                      data-lightbox-index={i}
                      data-lightbox-src={full.src}
                      data-lightbox-alt={image.alt}
                      aria-label={`View larger: ${image.alt}`}
                    >
                      <Image
                        src={image.src}
                        alt={image.alt}
                        widths={[300, 480, 640]}
                        sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
                        loading="lazy"
                        decoding="async"
                        class="aspect-[4/3] h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                      />
                    </button>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }

      <div class="mt-20 border-t border-line pt-10">
        <a
          href="/#inquire"
          class="inline-block rounded-full bg-blue px-7 py-3.5 font-semibold text-white transition-transform hover:-translate-y-0.5"
        >
          Request your stay
        </a>
      </div>
    </div>
  </section>

  <Lightbox slot="overlay" />
</Base>
