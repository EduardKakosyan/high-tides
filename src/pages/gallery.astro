---
// /gallery: every photo, front door to back deck to the beach, in one grid.
// Every fifth photo is a large tile (alternating left and right) so the page
// reads like a photo tour rather than a contact sheet. Each tile is a
// <button> that opens the shared Lightbox; alt text is the only description.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Lightbox from '../components/Lightbox.astro';
import { allImages, morphName } from '../data/gallery';

// Pre-generate an optimized full-size WebP for each image, in list order, so
// the lightbox triggers carry a clean URL + a stable index.
const fullViews = await Promise.all(
  allImages.map((image) => getImage({ src: image.src, width: 1600, format: 'webp' })),
);

// The lead tile is this page's LCP element. It is preloaded from <head> with
// the exact same widths/sizes/format/quality the <Image> below renders, so
// the browser starts fetching it before CSS and fonts, at high priority.
// Every other tile is lazy AND low priority: on a slow connection Chrome's
// lazy-load distance is large enough that the next rows start downloading
// too, and without the hint they pushed the lead past the 2.5 s budget.
const largeWidths = [480, 768, 1080];
const smallWidths = [300, 480, 640];
const largeSizes = '(min-width: 1024px) 50vw, 100vw';
const smallSizes = '(min-width: 1024px) 25vw, 50vw';
const leadQuality = 70;
const leadPreload = await getImage({
  src: allImages[0].src,
  widths: largeWidths,
  sizes: largeSizes,
  format: 'webp',
  quality: leadQuality,
});
---

<Base
  title="Photos, Hi Tides, Port Mouton, Nova Scotia"
  description="Every photo of Hi Tides, a two-bedroom cottage above the beach in Port Mouton, Nova Scotia: the living room, kitchen, bedrooms, bathrooms, deck, outdoor shower, and the beach."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={leadPreload.srcSet.attribute}
    imagesizes={largeSizes}
    fetchpriority="high"
  />
  <section class="bg-bg">
    <div class="mx-auto max-w-6xl px-5 pb-20 pt-24 sm:px-8 sm:pb-24 sm:pt-32">
      <a href="/" class="link-arrow text-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        Back to home
      </a>

      <h1 class="mt-8 max-w-[20ch] text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
        A look around.
      </h1>
      <p class="mt-4 max-w-[52ch] text-base text-muted">
        Front door to back deck, in the order you would walk it. Select any photo to see it larger.
      </p>

      <ul
        class="mt-10 grid grid-flow-dense grid-cols-2 gap-2 sm:gap-3 md:grid-cols-4 [&>li:nth-child(5n+1)]:col-span-2 [&>li:nth-child(5n+1)]:row-span-2 md:[&>li:nth-child(10n+6)]:col-start-3"
      >
        {
          allImages.map((image, i) => {
            const full = fullViews[i];
            const large = i % 5 === 0;
            return (
              <li transition:name={morphName(image)}>
                <button
                  type="button"
                  class="group block h-full w-full overflow-hidden rounded-xl bg-surface focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue"
                  data-lightbox-trigger
                  data-lightbox-index={i}
                  data-lightbox-src={full.src}
                  data-lightbox-alt={image.alt}
                  aria-label={`View larger: ${image.alt}`}
                >
                  <Image
                    src={image.src}
                    alt={image.alt}
                    format="webp"
                    widths={large ? largeWidths : smallWidths}
                    sizes={large ? largeSizes : smallSizes}
                    quality={i === 0 ? leadQuality : undefined}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'low'}
                    decoding="async"
                    class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </button>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/#inquire" class="btn btn-primary">Request your stay</a>
        <a href="/" class="link-arrow">
          Back to home
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14 M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <Lightbox slot="overlay" />
</Base>
